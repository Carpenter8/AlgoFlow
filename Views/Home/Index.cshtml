@{
    ViewData["Title"] = "Master Algorithms. Build Your Logic.";
}

<section class="hero-section">
    <div class="container hero-grid">
        <div class="hero-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> A clearer path to problem solving</div>
            <h1>Think in steps.<br /><span class="gradient-text">Solve with confidence.</span></h1>
            <p class="hero-description">
                Build a strong foundation in data structures and algorithms with a thoughtful,
                step-by-step learning experience.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">
                    Start learning <span aria-hidden="true">↗</span>
                </a>
                <a class="text-link" href="#curriculum">Explore the curriculum <span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-note">
                <span class="note-icon" aria-hidden="true">✦</span>
                <span>Learn the why behind every algorithm.</span>
            </div>
        </div>

        <div class="visual-card" role="img" aria-label="Illustration of an algorithmic path through connected nodes">
            <div class="visual-card-top">
                <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="visual-label">A path through the problem</span>
                <span class="visual-menu" aria-hidden="true">•••</span>
            </div>
            <div class="algorithm-visual" aria-hidden="true">
                <div class="node node-start"><span>start</span><b>01</b></div>
                <div class="path-line path-one"></div>
                <div class="node node-active"><span>think</span><b>02</b></div>
                <div class="path-line path-two"></div>
                <div class="node node-end"><span>solve</span><b>03</b></div>
                <div class="visual-code">
                    <span class="code-muted">// progress, not perfection</span>
                    <span><i>while</i> (curious) {</span>
                    <span class="code-indent">learn();</span>
                    <span class="code-indent">practice();</span>
                    <span>}</span>
                </div>
                <div class="floating-chip chip-complexity"><span>↗</span> one step at a time</div>
                <div class="floating-chip chip-pattern"><span>✦</span> patterns emerge</div>
            </div>
            <div class="visual-card-bottom">
                <span><span class="status-dot"></span> Your next idea is one step away</span>
                <span class="visual-index">01 / 03</span>
            </div>
        </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
</section>

<section class="curriculum-section section-pad" id="curriculum">
    <div class="container">
        <div class="section-heading">
            <div>
                <div class="eyebrow"><span class="eyebrow-dot"></span> The learning path</div>
                <h2>Strong fundamentals.<br /><span class="muted-heading">Lasting intuition.</span></h2>
            </div>
            <p>Move from core concepts to the patterns behind harder problems. Learn at your pace and build on what you know.</p>
        </div>
        <div class="path-grid">
            <article class="path-card">
                <span class="path-number">01</span>
                <span class="path-icon icon-violet" aria-hidden="true">⌘</span>
                <h3>Build your foundation</h3>
                <p>Get comfortable with complexity, arrays, strings, and the building blocks of problem solving.</p>
                <span class="path-topics">Complexity <i>·</i> Arrays <i>·</i> Strings</span>
            </article>
            <article class="path-card path-card-featured">
                <span class="path-number">02</span>
                <span class="path-icon icon-blue" aria-hidden="true">⌁</span>
                <h3>Recognize the patterns</h3>
                <p>Explore recursion, trees, graphs, and the recurring ideas that make complex problems approachable.</p>
                <span class="path-topics">Recursion <i>·</i> Trees <i>·</i> Graphs</span>
            </article>
            <article class="path-card">
                <span class="path-number">03</span>
                <span class="path-icon icon-pink" aria-hidden="true">◈</span>
                <h3>Think more deeply</h3>
                <p>Practice choosing trade-offs and combining techniques for advanced problem-solving scenarios.</p>
                <span class="path-topics">Greedy <i>·</i> Dynamic programming</span>
            </article>
        </div>
    </div>
</section>

<section class="approach-section section-pad" id="approach">
    <div class="container approach-grid">
        <div class="approach-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> A better way to learn</div>
            <h2>Understand the idea.<br /><span class="muted-heading">Then make it yours.</span></h2>
            <p>Algorithms become easier when you can see how each idea connects to the next. AlgoFlow is being built around clear explanations, deliberate practice, and progress you can own.</p>
            <a class="text-link" href="#curriculum">See the learning path <span aria-hidden="true">→</span></a>
        </div>
        <div class="approach-list">
            <article class="approach-item">
                <span class="approach-icon" aria-hidden="true">01</span>
                <div><h3>Make concepts click</h3><p>Start with the intuition, then explore how the algorithm works.</p></div>
            </article>
            <article class="approach-item">
                <span class="approach-icon" aria-hidden="true">02</span>
                <div><h3>Practice with purpose</h3><p>Use what you learn to tackle patterns, one step at a time.</p></div>
            </article>
            <article class="approach-item">
                <span class="approach-icon" aria-hidden="true">03</span>
                <div><h3>Keep your momentum</h3><p>Build a steady learning habit and return to ideas whenever you need.</p></div>
            </article>
        </div>
    </div>
</section>

<section class="closing-section">
    <div class="container closing-card">
        <div>
            <div class="eyebrow"><span class="eyebrow-dot"></span> Start with one idea</div>
            <h2>Your next breakthrough<br />starts with a first step.</h2>
        </div>
        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">
            Create your account <span aria-hidden="true">↗</span>
        </a>
    </div>
</section>
